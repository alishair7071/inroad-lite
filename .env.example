# Get a key at https://olostep.com.
OLOSTEP_API_KEY=

# Optional
OLOSTEP_BASE_URL=https://api.olostep.com/v1
# Searches filtered to job-board sites can take 45 seconds or more.
OLOSTEP_TIMEOUT_SECONDS=60
# Where search results are cached, so re-runs do not spend credits.
INROAD_LITE_CACHE_DIR=.cache

# Website only (uv run uvicorn main:app, or on Vercel).
# The code visitors must enter; without it the site refuses to search.
INROAD_LITE_ACCESS_CODE=
# Runs allowed per hour, per server instance.
INROAD_LITE_RUNS_PER_HOUR=10
